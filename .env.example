# Copy to .env (git-ignored) and fill in. Used by the microservices via docker-compose.
# Never put these in the Android app. See database/README.md for where to find each value.

# Project Settings -> Data API
SUPABASE_URL=https://<project-ref>.supabase.co

# Project Settings -> API Keys
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# "Connect" button -> Session pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
